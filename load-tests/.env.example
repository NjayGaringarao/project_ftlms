# Copy to .env and fill in. Values below mirror web-app/.env.example so this
# points at the SAME local Supabase instance the app itself uses.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_SECRET_DEFAULT_KEY=

# The running Next.js dev server (npm run dev in web-app/).
SITE_URL=http://localhost:3000

# Set to 1 to allow scripts to run against a non-localhost Supabase URL.
# Leave unset for normal use — this is a safety guard against accidentally
# seeding/mutating/load-testing a shared or production database.
LOAD_TEST_ALLOW_REMOTE=

# --- Test users -------------------------------------------------------
# Persona credentials no longer live here — `npm run seed` reads
# load-tests/base_users.csv instead (gitignored; see README.md for the
# expected columns and how the four k6-required roles are derived from it).

# --- Tuning ---------------------------------------------------------------
# Number of pre-queued campus_college_load revisions to seed per evaluation
# step for the REST-mode evaluate load test. Size roughly as
# VUS * DURATION_SECONDS / expected_seconds_per_iteration.
LOAD_TEST_EVAL_BATCH_SIZE=20

# k6 run overrides (all optional, k6 scripts fall back to sane defaults).
LOAD_TEST_VUS=10
LOAD_TEST_DURATION=30s
LOAD_TEST_ITERATIONS=3
# Browser VUs are real headless Chrome instances (expensive) and are capped
# at ITERATIONS by the scripts, so this is deliberately small/separate from
# LOAD_TEST_VUS (which sizes the cheap HTTP-only REST scenarios).
LOAD_TEST_BROWSER_VUS=2

# --- Ramp (*.rest.ramp.js) -------------------------------------------------
# Step/staircase VU profile: climbs through each target in turn, holding at
# each level for LOAD_TEST_RAMP_STAGE_DURATION before moving to the next.
# Used by `loadtest:scheduler:rest:ramp` / `loadtest:ccl:rest:ramp` to find
# the VU level where error rate or p95 latency starts climbing, in one run.
LOAD_TEST_RAMP_TARGETS=10,25,50,75,100
LOAD_TEST_RAMP_STAGE_DURATION=30s
LOAD_TEST_RAMP_STEP_DURATION=5s
