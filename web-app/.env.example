NEXT_PUBLIC_SUPABASE_URL=https://jfc...v.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=sb_publishable_TsX...iGZf
SUPABASE_SECRET_DEFAULT_KEY=sb_secret__KB...Ik_B
# In production (e.g. Railway), this must be the deployed HTTPS app URL.
# Example: https://your-app-name.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only origin for authentication emails. Read at runtime, so a
# Railway runtime variable can override the public URL embedded during build.
# SITE_URL=https://your-app-name.up.railway.app

# Local-only: lets /api/load-test/* stay reachable under a `next build`/`next
# start` production build for load testing. Never set this in a real deployed
# environment's config. See web-app/src/app/api/load-test/*/route.ts.
LOAD_TEST_ROUTES_ENABLED=0
